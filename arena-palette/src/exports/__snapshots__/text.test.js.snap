exports[`text exports (v1.31 output) > css 1`] = `
"/*
 * arena-palette export
 * Test image
 * https://www.are.na/block/123
 */

:root {
  /* Palette */
  --red: hsl(0, 100%, 50%); /* #ff0000 (60%) */
  --color-2: hsl(210, 50%, 8%); /* #0a141e (30%) */
  --mustard: hsl(49, 50%, 57%); /* #c8b45a (10%) */

  /* Semantic palette */
  --semantic-vibrant: hsl(0, 100%, 50%); /* #ff0000 (70%) */
  --semantic-dark-muted: hsl(210, 50%, 8%); /* #0a141e (30%) */

  /* Tints & shades */
  --red-tint-3: hsl(0, 100%, 84%); /* #ffacac */
  --red-tint-2: hsl(0, 100%, 73%); /* #ff7373 */
  --red-tint-1: hsl(0, 100%, 61%); /* #ff3939 */
  --red-base: hsl(0, 100%, 50%); /* #ff0000 */
  --red-shade-1: hsl(0, 100%, 37%); /* #bf0000 */
  --red-shade-2: hsl(0, 100%, 25%); /* #800000 */
  --red-shade-3: hsl(0, 100%, 13%); /* #400000 */

  --color-2-tint-3: hsl(210, 50%, 73%); /* #99bbdd */
  --color-2-tint-2: hsl(210, 50%, 51%); /* #4583c1 */
  --color-2-tint-1: hsl(210, 50%, 30%); /* #264c72 */
  --color-2-base: hsl(210, 50%, 8%); /* #0a141e */
  --color-2-shade-1: hsl(212, 48%, 6%); /* #080f17 */
  --color-2-shade-2: hsl(208, 52%, 5%); /* #060d13 */
  --color-2-shade-3: hsl(208, 52%, 5%); /* #060d13 */

  --mustard-tint-3: hsl(49, 51%, 86%); /* #ede6c8 */
  --mustard-tint-2: hsl(49, 50%, 76%); /* #e0d5a3 */
  --mustard-tint-1: hsl(49, 50%, 66%); /* #d4c57f */
  --mustard-base: hsl(49, 50%, 57%); /* #c8b45a */
  --mustard-shade-1: hsl(49, 50%, 43%); /* #a49037 */
  --mustard-shade-2: hsl(49, 50%, 28%); /* #6d6024 */
  --mustard-shade-3: hsl(49, 51%, 14%); /* #373012 */
}"
`;

